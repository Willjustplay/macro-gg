{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and automation preferences.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner."
        },
        "displayName": {
          "type": "string",
          "description": "User display name."
        },
        "email": {
          "type": "string",
          "description": "User email address."
        },
        "themeMode": {
          "type": "string",
          "enum": ["SYSTEM", "LIGHT", "DARK"],
          "description": "Material 3 adaptive theme preference."
        },
        "defaultTapDurationMs": {
          "type": "integer",
          "description": "Default tap duration in milliseconds."
        },
        "jitterRadiusPx": {
          "type": "integer",
          "description": "Random touch offset radius in pixels."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "displayName", "themeMode", "defaultTapDurationMs", "jitterRadiusPx", "createdAt", "updatedAt"]
    },
    "VisualMacro": {
      "title": "VisualMacro",
      "description": "Visual click, swipe, and color-wait automation macro sequence.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "name": {
          "type": "string",
          "description": "Macro display name."
        },
        "description": {
          "type": "string",
          "description": "Short summary of the macro."
        },
        "loopCount": {
          "type": "integer",
          "description": "Number of loop iterations; 0 means infinite."
        },
        "loopDelayMs": {
          "type": "integer",
          "description": "Delay between loops in milliseconds."
        },
        "stopOnError": {
          "type": "boolean",
          "description": "Whether execution stops on step failure or timeout."
        },
        "steps": {
          "type": "array",
          "description": "Ordered list of visual macro action step maps (max 50)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "name", "description", "loopCount", "loopDelayMs", "stopOnError", "steps", "createdAt", "updatedAt"]
    },
    "LuaScript": {
      "title": "LuaScript",
      "description": "Custom sandboxed Lua automation script authored by the user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "description": "Script title."
        },
        "description": {
          "type": "string",
          "description": "Script notes or purpose."
        },
        "code": {
          "type": "string",
          "description": "Lua 5.2 source code."
        },
        "tags": {
          "type": "array",
          "description": "Bounded tag labels (max 10)."
        },
        "lastRunStatus": {
          "type": "string",
          "enum": ["NEVER", "SUCCESS", "STOPPED", "ERROR"],
          "description": "Result status of the most recent execution."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "title", "description", "code", "tags", "lastRunStatus", "createdAt", "updatedAt"]
    },
    "RunHistoryEntry": {
      "title": "RunHistoryEntry",
      "description": "Immutable summary of a completed or stopped macro/Lua execution session.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "targetType": {
          "type": "string",
          "enum": ["MACRO", "LUA"],
          "description": "Whether the run executed a visual macro or a Lua script."
        },
        "targetId": {
          "type": "string",
          "description": "Document ID of the executed macro or script."
        },
        "targetName": {
          "type": "string",
          "description": "Snapshot name of the executed macro or script."
        },
        "status": {
          "type": "string",
          "enum": ["SUCCESS", "STOPPED", "ERROR"],
          "description": "Final run outcome."
        },
        "durationMs": {
          "type": "integer",
          "description": "Total elapsed time in milliseconds."
        },
        "actionsExecuted": {
          "type": "integer",
          "description": "Total click/swipe/color operations performed."
        },
        "summaryMessage": {
          "type": "string",
          "description": "Human-readable execution summary or error message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Execution completion timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "targetType", "targetId", "targetName", "status", "durationMs", "actionsExecuted", "summaryMessage", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Per-user profile and automation settings isolated by Firebase Auth UID."
    },
    "/users/{userId}/macros/{macroId}": {
      "schema": { "$ref": "#/entities/VisualMacro" },
      "description": "User-owned visual click/swipe/color-wait macros."
    },
    "/users/{userId}/scripts/{scriptId}": {
      "schema": { "$ref": "#/entities/LuaScript" },
      "description": "User-owned custom Lua automation scripts."
    },
    "/users/{userId}/runHistory/{runId}": {
      "schema": { "$ref": "#/entities/RunHistoryEntry" },
      "description": "Append-only execution history entries for user runs."
    }
  }
}
