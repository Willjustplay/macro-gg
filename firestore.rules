rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 160)) &&
             data.themeMode is string && data.themeMode in ['SYSTEM', 'LIGHT', 'DARK'] &&
             data.defaultTapDurationMs is int && data.defaultTapDurationMs >= 10 && data.defaultTapDurationMs <= 5000 &&
             data.jitterRadiusPx is int && data.jitterRadiusPx >= 0 && data.jitterRadiusPx <= 100 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidVisualMacro(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.description is string && data.description.size() <= 300 &&
             data.loopCount is int && data.loopCount >= 0 && data.loopCount <= 100000 &&
             data.loopDelayMs is int && data.loopDelayMs >= 0 && data.loopDelayMs <= 600000 &&
             data.stopOnError is bool &&
             data.steps is list && data.steps.size() <= 50 &&
             (data.steps.size() == 0 || data.steps[0] is map) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidLuaScript(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.description is string && data.description.size() <= 300 &&
             data.code is string && data.code.size() >= 1 && data.code.size() <= 50000 &&
             data.tags is list && data.tags.size() <= 10 &&
             (data.tags.size() == 0 || data.tags[0] is string) &&
             data.lastRunStatus is string && data.lastRunStatus in ['NEVER', 'SUCCESS', 'STOPPED', 'ERROR'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRunHistoryEntry(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.targetType is string && data.targetType in ['MACRO', 'LUA'] &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 100 &&
             data.status is string && data.status in ['SUCCESS', 'STOPPED', 'ERROR'] &&
             data.durationMs is int && data.durationMs >= 0 && data.durationMs <= 86400000 &&
             data.actionsExecuted is int && data.actionsExecuted >= 0 && data.actionsExecuted <= 1000000 &&
             data.summaryMessage is string && data.summaryMessage.size() <= 400 &&
             isValidTimestamp(data.createdAt);
    }

    // --- USER PROFILE & NESTED SUBCOLLECTIONS ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'themeMode', 'defaultTapDurationMs', 'jitterRadiusPx', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'themeMode', 'defaultTapDurationMs', 'jitterRadiusPx', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidUserProfile(incoming()) &&
                       isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'themeMode', 'defaultTapDurationMs', 'jitterRadiusPx', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Visual Macros Subcollection
      match /macros/{macroId} {
        allow get: if isOwner(userId) && isValidId(macroId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(macroId) &&
                         incoming().keys().hasAll(['userId', 'name', 'description', 'loopCount', 'loopDelayMs', 'stopOnError', 'steps', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'description', 'loopCount', 'loopDelayMs', 'stopOnError', 'steps', 'createdAt', 'updatedAt']) &&
                         isValidVisualMacro(incoming());

        allow update: if isSignedIn() &&
                         isValidVisualMacro(incoming()) &&
                         isOwner(userId) &&
                         isValidId(macroId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'loopCount', 'loopDelayMs', 'stopOnError', 'steps', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(macroId);
      }

      // Lua Scripts Subcollection
      match /scripts/{scriptId} {
        allow get: if isOwner(userId) && isValidId(scriptId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(scriptId) &&
                         incoming().keys().hasAll(['userId', 'title', 'description', 'code', 'tags', 'lastRunStatus', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'description', 'code', 'tags', 'lastRunStatus', 'createdAt', 'updatedAt']) &&
                         isValidLuaScript(incoming());

        allow update: if isSignedIn() &&
                         isValidLuaScript(incoming()) &&
                         isOwner(userId) &&
                         isValidId(scriptId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'code', 'tags', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['lastRunStatus', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'code', 'tags', 'lastRunStatus', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(scriptId);
      }

      // Execution Run History Subcollection (Immutable append-only records)
      match /runHistory/{runId} {
        allow get: if isOwner(userId) && isValidId(runId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(runId) &&
                         incoming().keys().hasAll(['userId', 'targetType', 'targetId', 'targetName', 'status', 'durationMs', 'actionsExecuted', 'summaryMessage', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'targetType', 'targetId', 'targetName', 'status', 'durationMs', 'actionsExecuted', 'summaryMessage', 'createdAt']) &&
                         isValidRunHistoryEntry(incoming());

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(runId);
      }
    }
  }
}
